{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Lab",
  "version": "0.1.0",
  "identifier": "com.muteshand.ailab",
  "build": {
    "beforeDevCommand": "cd frontend && npm run dev",
    "beforeBuildCommand": "cd frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "frontend-dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Lab",
        "width": 1200,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}