# =========================
# OS / SYSTEM FILES
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# PYTHON
# =========================
__pycache__/
*.pyc
*.pyo
*.pyd
*.cache

# =========================
# ENV / VIRTUAL ENVS
# =========================
venv/
.venv/
env/
ENV/

# =========================
# SECRETS / KEYS
# =========================
*.secret*
.webui_secret_key
*.env
.env.*

# =========================
# DEBUG / TEMP SCRIPTS
# =========================
*_debug.py
debug_*.py
audit_*.py
certification_*.py

# =========================
# TEMP FILES / LOCAL TEST JUNK
# =========================
*.log
*.tmp

# Ignore random text junk (from your workflow)
# Ignore random root-level txt junk
/*.txt

# Ignore junk inside harness_cases
tests/harness_cases/*.txt

# Keep ALL important docs
!Project Docs/*.txt

# BUT KEEP intentional test files (if you ever add structured ones)
!tests/**/*.txt

# =========================
# TEST OUTPUT / ARTIFACTS
# =========================
test_output.txt
tool_coverage_audit.json

# =========================
# HARNESS CASES (KEEP CORE, IGNORE JUNK)
# =========================
# Keep real test cases
# Ignore messy/manual files inside

tests/harness_cases/*.txt
tests/harness_cases/debug_*
tests/harness_cases/temp_*

# =========================
# LOCAL EXPERIMENT FILES
# =========================
notes.txt
verify.txt
safe.txt

# =========================
# SYSTEM LOCAL CONFIG
# =========================
system/config/

# =========================
# LEGACY / DEPRECATED SYSTEMS
# =========================
projects/manager/

# Also ignore nested junk inside projects
projects/**/venv/
projects/**/__pycache__/

# =========================
# IDE
# =========================
.vscode/
.idea/

# =========================
# SAFETY RULES (DO NOT REMOVE)
# =========================
# These are CORE SYSTEM FILES — NEVER IGNORE:

#!system/
#!tools/
#!memory/
#!Project Docs/
#!tests/harness_cases/